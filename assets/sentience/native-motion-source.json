  "reconstruction": {
    "reasonRequired": "Existing exporter drops Animator/classID95 Humanoid muscle bindings. Its original FBX retains accessory and weapon tracks but has no core body Transform tracks.",
    "rotation": "Evaluate original named muscle curves, native min/max/sign and Avatar PreQ/PostQ. Tangent half-angle swing plus native twist. Native HandQ/FootQ provide end-effector rotations after undoing native PostQ.",
    "root": "Use original RootT/RootQ and original four hand/foot IK targets. Foot targets are converted from sole to ankle by the native rest-pose sole height. A rigid registration recovers the root without scaling any limb.",
    "sourceInterpolation": "Original keyed float values and Hermite slopes, sampled at 60 Hz; durations use native m_StopTime rather than duplicated end padding.",
    "referenceMath": "https://gitlab.com/lox9973/ShaderMotion/-/blob/master/Script/Common/HumanAxes.cs",
    "referenceHumanoidAndGoals": "https://github.com/Unity-Technologies/UnityCsReference/blob/master/Modules/Animation/ScriptBindings/HumanPoseHandler.bindings.cs",
    "referenceHumanoidDefinition": "https://unity.com/blog/engine-platform/mecanim-humanoids",
    "formulaVerification": "Tangent swing and source goal rotations were checked against the independent serialized original IK endpoints. A direct angle-axis yz approximation had larger residual and was rejected.",
    "unityEditorUsed": false,
    "unityEditorProbe": "Installed 2021.3.4f1 reported no valid license; no activation or license bypass attempted."
  },
  "validation": {
    "godotAll24BodyClipsMove": true,
    "framesSampled": 3639,
    "maximumBoneLengthErrorMeters": 2.5331974029541e-07,
    "sourceEndpointWeightedMeanErrorMeters": 0.0023649340384312755,
    "sourceEndpointMaximumErrorMeters": 0.042868973610524254,
    "sourceEndpointWorstClip": "Victory",
    "reports": [
