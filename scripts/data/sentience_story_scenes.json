  "scenes": {
    "A01": {
      "title": "首次进入",
      "sourceSceneId": "A01",
      "sourceLine": 9,
      "lines": [
        {
          "id": "A01-01",
          "speaker": "senti",
          "text": "老古董，往这儿看！五个幻身，最后一场我亲自来。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 11
        },
        {
          "id": "A01-02",
          "speaker": "fuhua",
          "text": "确实花了不少心思。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 12
        },
        {
          "id": "A01-03",
          "speaker": "senti",
          "text": "那可不！打完带你去吃云吞面，店我都挑好了。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 13
        },
        {
          "id": "A01-04",
          "speaker": "fuhua",
          "text": "好。我会认真打。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 14
        }
      ],
      "stageDirections": []
    },
    "A02": {
      "title": "再次挑战",
      "sourceSceneId": "A02",
      "sourceLine": 16,
      "lines": [
        {
          "id": "A02-01",
          "speaker": "senti",
          "text": "哟？休息好了，老古董？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 18
        },
        {
          "id": "A02-02",
          "speaker": "fuhua",
          "text": "嗯。我想再试试。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 19
        }
      ],
      "stageDirections": []
    },
    "A03": {
      "title": "明镜",
      "sourceSceneId": "A03",
      "sourceLine": 21,
      "lines": [
        {
          "id": "A03-01",
          "speaker": "senti",
          "text": "破绽我可给你留了。哪个是真的，你自己猜。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 23
        },
        {
          "id": "A03-02",
          "speaker": "fuhua",
          "text": "那就交手看看。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 24
        }
      ],
      "stageDirections": []
    },
    "A04": {
      "title": "流转",
      "sourceSceneId": "A04",
      "sourceLine": 26,
      "lines": [
        {
          "id": "A04-01",
          "speaker": "senti",
          "text": "看看是我的剑快，还是你闪得快！",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 28
        },
        {
          "id": "A04-02",
          "speaker": "fuhua",
          "text": "请。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 29
        }
      ],
      "stageDirections": []
    },
    "A05": {
      "title": "破阵",
      "sourceSceneId": "A05",
      "sourceLine": 31,
      "lines": [
        {
          "id": "A05-01",
          "speaker": "senti",
          "text": "破阵？哈，我最想看这条了。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 33
        },
        {
          "id": "A05-02",
          "speaker": "fuhua",
          "text": "看来你很有把握。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 34
        }
      ],
      "stageDirections": []
    },
    "A06": {
      "title": "多重规矩",
      "sourceSceneId": "A06",
      "sourceLine": 36,
      "lines": [
        {
          "id": "A06-01",
          "speaker": "senti",
          "text": "还真敢一起选啊。待会儿可别反悔！",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 38
        },
        {
          "id": "A06-02",
          "speaker": "fuhua",
          "text": "来吧。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 39
        }
      ],
      "stageDirections": []
    },
    "A07": {
      "title": "通关后重访",
      "sourceSceneId": "A07",
      "sourceLine": 41,
      "lines": [
        {
          "id": "A07-01",
          "speaker": "senti",
          "text": "上回的空当，我可补上了。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 43
        },
        {
          "id": "A07-02",
          "speaker": "fuhua",
          "text": "那得先试过才知道。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 44
        }
      ],
      "stageDirections": []
    },
    "B01": {
      "title": "寸心如锋",
      "sourceSceneId": "B01",
      "sourceLine": 48,
      "lines": [
        {
          "id": "B01-01",
          "speaker": "senti",
          "text": "这张……你倒挺识货。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 50
        },
        {
          "id": "B01-02",
          "speaker": "fuhua",
          "text": "那就试试。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 51
        }
      ],
      "stageDirections": []
    },
    "B02": {
      "title": "破阵之势",
      "sourceSceneId": "B02",
      "sourceLine": 53,
      "lines": [
        {
          "id": "B02-01",
          "speaker": "fuhua",
          "text": "你研究过我的步法。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 55
        },
        {
          "id": "B02-02",
          "speaker": "senti",
          "text": "研究？我都会！不过是换个使法。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 56
        }
      ],
      "stageDirections": []
    },
    "B03": {
      "title": "以攻代守",
      "sourceSceneId": "B03",
      "sourceLine": 58,
      "lines": [
        {
          "id": "B03-01",
          "speaker": "senti",
          "text": "嗬，今天要来点狠的？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 60
        },
        {
          "id": "B03-02",
          "speaker": "fuhua",
          "text": "正想试试。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 61
        }
      ],
      "stageDirections": []
    },
    "B04": {
      "title": "三叠归元",
      "sourceSceneId": "B04",
      "sourceLine": 63,
      "lines": [
        {
          "id": "B04-01",
          "speaker": "fuhua",
          "text": "第三式收得很干净。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 65
        },
        {
          "id": "B04-02",
          "speaker": "senti",
          "text": "不错嘛，你是第一个夸它收得好的。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 66
        }
      ],
      "stageDirections": []
    },
    "B05": {
      "title": "明镜止水",
      "sourceSceneId": "B05",
      "sourceLine": 68,
      "lines": [
        {
          "id": "B05-01",
          "speaker": "senti",
          "text": "喘口气吧，下一场可不等你。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 70
        },
        {
          "id": "B05-02",
          "speaker": "fuhua",
          "text": "多谢。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 71
        }
      ],
      "stageDirections": []
    },
    "B06": {
      "title": "反照",
      "sourceSceneId": "B06",
      "sourceLine": 73,
      "lines": [
        {
          "id": "B06-01",
          "speaker": "senti",
          "text": "我倒想看看，你会不会吃自己招式的亏。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 75
        },
        {
          "id": "B06-02",
          "speaker": "fuhua",
          "text": "原来在这里等着我。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 76
        }
      ],
      "stageDirections": []
    },
    "B07": {
      "title": "守一",
      "sourceSceneId": "B07",
      "sourceLine": 78,
      "lines": [
        {
          "id": "B07-01",
          "speaker": "fuhua",
          "text": "后面那条溪，我想去看看。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 80
        },
        {
          "id": "B07-02",
          "speaker": "senti",
          "text": "打完再去，先别跑题！",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 81
        }
      ],
      "stageDirections": []
    },
    "B08": {
      "title": "生生不息",
      "sourceSceneId": "B08",
      "sourceLine": 83,
      "lines": [
        {
          "id": "B08-01",
          "speaker": "senti",
          "text": "你要是半路就打不动了，我才没意思呢。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 85
        },
        {
          "id": "B08-02",
          "speaker": "fuhua",
          "text": "放心，最后还要与你交手。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 86
        }
      ],
      "stageDirections": []
    },
    "B09": {
      "title": "行云流水",
      "sourceSceneId": "B09",
      "sourceLine": 88,
      "lines": [
        {
          "id": "B09-01",
          "speaker": "senti",
          "text": "这回可别打一半就停啊。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 90
        },
        {
          "id": "B09-02",
          "speaker": "fuhua",
          "text": "我知道分寸。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 91
        }
      ],
      "stageDirections": []
    },
    "B10": {
      "title": "招随心转",
      "sourceSceneId": "B10",
      "sourceLine": 93,
      "lines": [
        {
          "id": "B10-01",
          "speaker": "fuhua",
          "text": "这里没有固定的接法？",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 95
        },
        {
          "id": "B10-02",
          "speaker": "senti",
          "text": "想怎么打就怎么打，对手又不会乖乖站好。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 96
        }
      ],
      "stageDirections": []
    },
    "B11": {
      "title": "乘风",
      "sourceSceneId": "B11",
      "sourceLine": 98,
      "lines": [
        {
          "id": "B11-01",
          "speaker": "senti",
          "text": "考考你借势换位的能力。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 100
        },
        {
          "id": "B11-02",
          "speaker": "fuhua",
          "text": "行。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 101
        }
      ],
      "stageDirections": []
    },
    "B12": {
      "title": "气贯长虹",
      "sourceSceneId": "B12",
      "sourceLine": 103,
      "lines": [
        {
          "id": "B12-01",
          "speaker": "senti",
          "text": "这名字怎么样？一听就厉害吧！",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 105
        },
        {
          "id": "B12-02",
          "speaker": "fuhua",
          "text": "嗯，很响亮。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 106
        }
      ],
      "stageDirections": []
    },
    "B13": {
      "title": "乘隙而入",
      "sourceSceneId": "B13",
      "sourceLine": 108,
      "lines": [
        {
          "id": "B13-01",
          "speaker": "senti",
          "text": "喂，躲过去就算了？不还我一拳？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 110
        },
        {
          "id": "B13-02",
          "speaker": "fuhua",
          "text": "这就来。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 111
        }
      ],
      "stageDirections": []
    },
    "B14": {
      "title": "百川归海",
      "sourceSceneId": "B14",
      "sourceLine": 113,
      "lines": [
        {
          "id": "B14-01",
          "speaker": "senti",
          "text": "第三下打完，可还有得接呢。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 115
        },
        {
          "id": "B14-02",
          "speaker": "fuhua",
          "text": "我试试这个。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 116
        }
      ],
      "stageDirections": []
    },
    "B15": {
      "title": "余焰不息",
      "sourceSceneId": "B15",
      "sourceLine": 118,
      "lines": [
        {
          "id": "B15-01",
          "speaker": "senti",
          "text": "大招放完就想歇？我还没打够呢。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 120
        },
        {
          "id": "B15-02",
          "speaker": "fuhua",
          "text": "那就接着来。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 121
        }
      ],
      "stageDirections": []
    },
    "B16": {
      "title": "摧锋",
      "sourceSceneId": "B16",
      "sourceLine": 123,
      "lines": [
        {
          "id": "B16-01",
          "speaker": "senti",
          "text": "站都站不稳了，你还等什么？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 125
        },
        {
          "id": "B16-02",
          "speaker": "fuhua",
          "text": "不会让它缓过来的。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 126
        }
      ],
      "stageDirections": []
    },
    "B17": {
      "title": "借势回锋",
      "sourceSceneId": "B17",
      "sourceLine": 128,
      "lines": [
        {
          "id": "B17-01",
          "speaker": "senti",
          "text": "挡完就追？真不给我喘口气啊。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 130
        },
        {
          "id": "B17-02",
          "speaker": "fuhua",
          "text": "你也不会等我的。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 131
        }
      ],
      "stageDirections": []
    },
    "B18": {
      "title": "决胜气",
      "sourceSceneId": "B18",
      "sourceLine": 133,
      "lines": [
        {
          "id": "B18-01",
          "speaker": "senti",
          "text": "打倒一个反倒更有精神了？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 135
        },
        {
          "id": "B18-02",
          "speaker": "fuhua",
          "text": "嗯。下一个吧。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 136
        }
      ],
      "stageDirections": []
    },
    "C01": {
      "title": "明镜止水 → 反照",
      "sourceSceneId": "C01",
      "sourceLine": 140,
      "lines": [
        {
          "id": "C01-01",
          "speaker": "senti",
          "text": "歇够了就去抓破绽？你还挺会安排。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 142
        },
        {
          "id": "C01-02",
          "speaker": "fuhua",
          "text": "总不能一直歇着。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 143
        }
      ],
      "stageDirections": []
    },
    "C02": {
      "title": "反照 → 明镜止水",
      "sourceSceneId": "C02",
      "sourceLine": 145,
      "lines": [
        {
          "id": "C02-01",
          "speaker": "senti",
          "text": "咦，怎么不追了？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 147
        },
        {
          "id": "C02-02",
          "speaker": "fuhua",
          "text": "你给的破绽，我得再想一想。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 148
        }
      ],
      "stageDirections": []
    },
    "C03": {
      "title": "以攻代守 → 生生不息",
      "sourceSceneId": "C03",
      "sourceLine": 150,
      "lines": [
        {
          "id": "C03-01",
          "speaker": "senti",
          "text": "这会儿又想起留力气了？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 152
        },
        {
          "id": "C03-02",
          "speaker": "fuhua",
          "text": "还要留着跟你打。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 153
        }
      ],
      "stageDirections": []
    },
    "C04": {
      "title": "生生不息 → 以攻代守",
      "sourceSceneId": "C04",
      "sourceLine": 155,
      "lines": [
        {
          "id": "C04-01",
          "speaker": "senti",
          "text": "前面还不紧不慢，现在说冲就冲？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 157
        },
        {
          "id": "C04-02",
          "speaker": "fuhua",
          "text": "只是想换种打法。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 158
        }
      ],
      "stageDirections": []
    },
    "C05": {
      "title": "行云流水 → 三叠归元",
      "sourceSceneId": "C05",
      "sourceLine": 160,
      "lines": [
        {
          "id": "C05-01",
          "speaker": "senti",
          "text": "你要把这串招收在第三下？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 162
        },
        {
          "id": "C05-02",
          "speaker": "fuhua",
          "text": "也可能是第二下。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 163
        }
      ],
      "stageDirections": []
    },
    "C06": {
      "title": "三叠归元 → 行云流水",
      "sourceSceneId": "C06",
      "sourceLine": 165,
      "lines": [
        {
          "id": "C06-01",
          "speaker": "senti",
          "text": "哎，这两张接反了吧？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 167
        },
        {
          "id": "C06-02",
          "speaker": "fuhua",
          "text": "不能这么用吗？",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 168
        }
      ],
      "stageDirections": []
    },
    "C07": {
      "title": "乘风 → 招随心转",
      "sourceSceneId": "C07",
      "sourceLine": 170,
      "lines": [
        {
          "id": "C07-01",
          "speaker": "senti",
          "text": "刚退开，怎么又贴上去了？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 172
        },
        {
          "id": "C07-02",
          "speaker": "fuhua",
          "text": "换个角度试试。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 173
        }
      ],
      "stageDirections": []
    },
    "C08": {
      "title": "招随心转 → 乘风",
      "sourceSceneId": "C08",
      "sourceLine": 175,
      "lines": [
        {
          "id": "C08-01",
          "speaker": "senti",
          "text": "哟，打到一半不打了？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 177
        },
        {
          "id": "C08-02",
          "speaker": "fuhua",
          "text": "再往前，你就该等着我了。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 178
        }
      ],
      "stageDirections": []
    },
    "D01": {
      "title": "进攻 → 守势",
      "sourceSceneId": "D01",
      "sourceLine": 182,
      "lines": [
        {
          "id": "D01-01",
          "speaker": "senti",
          "text": "打得正痛快呢，怎么改主意了？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 184
        },
        {
          "id": "D01-02",
          "speaker": "fuhua",
          "text": "刚才有几处没看清。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 185
        }
      ],
      "stageDirections": []
    },
    "D02": {
      "title": "进攻 → 流转",
      "sourceSceneId": "D02",
      "sourceLine": 187,
      "lines": [
        {
          "id": "D02-01",
          "speaker": "senti",
          "text": "哎？不跟它们硬碰了？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 189
        },
        {
          "id": "D02-02",
          "speaker": "fuhua",
          "text": "换一边看看。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 190
        }
      ],
      "stageDirections": []
    },
    "D03": {
      "title": "守势 → 进攻",
      "sourceSceneId": "D03",
      "sourceLine": 192,
      "lines": [
        {
          "id": "D03-01",
          "speaker": "senti",
          "text": "总算舍得先动手了？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 194
        },
        {
          "id": "D03-02",
          "speaker": "fuhua",
          "text": "再等下去，它也不出招。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 195
        }
      ],
      "stageDirections": []
    },
    "D04": {
      "title": "守势 → 流转",
      "sourceSceneId": "D04",
      "sourceLine": 197,
      "lines": [
        {
          "id": "D04-01",
          "speaker": "senti",
          "text": "这回想从哪边走？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 199
        },
        {
          "id": "D04-02",
          "speaker": "fuhua",
          "text": "你很快就知道了。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 200
        }
      ],
      "stageDirections": []
    },
    "D05": {
      "title": "流转 → 进攻",
      "sourceSceneId": "D05",
      "sourceLine": 202,
      "lines": [
        {
          "id": "D05-01",
          "speaker": "senti",
          "text": "怎么？跑够了？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 204
        },
        {
          "id": "D05-02",
          "speaker": "fuhua",
          "text": "这次换我来追。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 205
        }
      ],
      "stageDirections": []
    },
    "D06": {
      "title": "流转 → 守势",
      "sourceSceneId": "D06",
      "sourceLine": 207,
      "lines": [
        {
          "id": "D06-01",
          "speaker": "senti",
          "text": "这回不躲了？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 209
        },
        {
          "id": "D06-02",
          "speaker": "fuhua",
          "text": "那一招，我想正面接一次。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 210
        }
      ],
      "stageDirections": []
    },
    "E01": {
      "title": "进攻路线",
      "sourceSceneId": "E01",
      "sourceLine": 214,
      "lines": [
        {
          "id": "E01-01",
          "speaker": "senti",
          "text": "一路打得这么痛快，轮到我可别收手。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 216
        },
        {
          "id": "E01-02",
          "speaker": "fuhua",
          "text": "当然。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 217
        }
      ],
      "stageDirections": []
    },
    "E02": {
      "title": "守势路线",
      "sourceSceneId": "E02",
      "sourceLine": 219,
      "lines": [
        {
          "id": "E02-01",
          "speaker": "senti",
          "text": "前面那些招看够了吧？我可不照着它们来。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 221
        },
        {
          "id": "E02-02",
          "speaker": "fuhua",
          "text": "我也是这么想的。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 222
        }
      ],
      "stageDirections": []
    },
    "E03": {
      "title": "流转路线",
      "sourceSceneId": "E03",
      "sourceLine": 224,
      "lines": [
        {
          "id": "E03-01",
          "speaker": "senti",
          "text": "我的地方，我可比它们熟！",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 226
        },
        {
          "id": "E03-02",
          "speaker": "fuhua",
          "text": "那就请你赐教了。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 227
        }
      ],
      "stageDirections": []
    },
    "E04": {
      "title": "兼修路线",
      "sourceSceneId": "E04",
      "sourceLine": 229,
      "lines": [
        {
          "id": "E04-01",
          "speaker": "senti",
          "text": "藏了什么新招？让我亲自看看。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 231
        },
        {
          "id": "E04-02",
          "speaker": "fuhua",
          "text": "来吧。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 232
        }
      ],
      "stageDirections": []
    },
    "F01": {
      "title": "进攻获胜",
      "sourceSceneId": "F01",
      "sourceLine": 236,
      "lines": [
        {
          "id": "F01-01",
          "speaker": "senti",
          "text": "……好，刚才算你快。那拳待会儿再打一遍！",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 238
        },
        {
          "id": "F01-02",
          "speaker": "fuhua",
          "text": "吃完面再说。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 239
        }
      ],
      "stageDirections": []
    },
    "F02": {
      "title": "守势获胜",
      "sourceSceneId": "F02",
      "sourceLine": 241,
      "lines": [
        {
          "id": "F02-01",
          "speaker": "senti",
          "text": "你倒是上一次当给我看看啊！",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 243
        },
        {
          "id": "F02-02",
          "speaker": "fuhua",
          "text": "下次再试。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 244
        }
      ],
      "stageDirections": []
    },
    "F03": {
      "title": "流转获胜",
      "sourceSceneId": "F03",
      "sourceLine": 246,
      "lines": [
        {
          "id": "F03-01",
          "speaker": "senti",
          "text": "又让你绕过去了。下回可没这么容易！",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 248
        },
        {
          "id": "F03-02",
          "speaker": "fuhua",
          "text": "那我还得再想个办法。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 249
        }
      ],
      "stageDirections": []
    },
    "F04": {
      "title": "兼修获胜",
      "sourceSceneId": "F04",
      "sourceLine": 251,
      "lines": [
        {
          "id": "F04-01",
          "speaker": "senti",
          "text": "临时改招？行，下回我得想个接法。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 253
        },
        {
          "id": "F04-02",
          "speaker": "fuhua",
          "text": "我等着。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 254
        }
      ],
      "stageDirections": []
    },
    "G01": {
      "title": "幻身战落败",
      "sourceSceneId": "G01",
      "sourceLine": 258,
      "lines": [
        {
          "id": "G01-01",
          "speaker": "senti",
          "text": "先起来，地上凉。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 260
        }
      ],
      "stageDirections": []
    },
    "G02": {
      "title": "小识战落败",
      "sourceSceneId": "G02",
      "sourceLine": 262,
      "lines": [
        {
          "id": "G02-01",
          "speaker": "senti",
          "text": "哈哈！这回可赢得痛快！",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 264
        }
      ],
      "stageDirections": []
    },
    "G03": {
      "title": "进攻路线落败",
      "sourceSceneId": "G03",
      "sourceLine": 266,
      "lines": [
        {
          "id": "G03-01",
          "speaker": "fuhua",
          "text": "刚才有些急。再来一次。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 268
        }
      ],
      "stageDirections": []
    },
    "G04": {
      "title": "守势路线落败",
      "sourceSceneId": "G04",
      "sourceLine": 270,
      "lines": [
        {
          "id": "G04-01",
          "speaker": "fuhua",
          "text": "下一次，我先动手。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 272
        }
      ],
      "stageDirections": []
    },
    "G05": {
      "title": "流转路线落败",
      "sourceSceneId": "G05",
      "sourceLine": 274,
      "lines": [
        {
          "id": "G05-01",
          "speaker": "fuhua",
          "text": "刚才那一步走错了。再试试。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 276
        }
      ],
      "stageDirections": []
    },
    "G06": {
      "title": "兼修路线落败",
      "sourceSceneId": "G06",
      "sourceLine": 278,
      "lines": [
        {
          "id": "G06-01",
          "speaker": "fuhua",
          "text": "接招慢了一瞬。再来。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 280
        }
      ],
      "stageDirections": []
    },
    "H01": {
      "title": "场景闲谈",
      "sourceSceneId": "H01",
      "sourceLine": 284,
      "lines": [
        {
          "id": "H01-01",
          "speaker": "fuhua",
          "text": "远处那声音，是钟？",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 286
        },
        {
          "id": "H01-02",
          "speaker": "senti",
          "text": "咱们刚才对拳的回声！是不是挺响亮？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 287
        }
      ],
      "stageDirections": []
    },
    "H02": {
      "title": "还剩两关",
      "sourceSceneId": "H02",
      "sourceLine": 289,
      "lines": [
        {
          "id": "H02-01",
          "speaker": "senti",
          "text": "还剩两场，打得过瘾吧？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 291
        },
        {
          "id": "H02-02",
          "speaker": "fuhua",
          "text": "嗯，比我预想的难。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 292
        }
      ],
      "stageDirections": []
    },
    "H03": {
      "title": "独立决战引子",
      "sourceSceneId": "H03",
      "sourceLine": 294,
      "lines": [
        {
          "id": "H03-01",
          "speaker": "senti",
          "text": "前头的都退下。换我！",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 296
        },
        {
          "id": "H03-02",
          "speaker": "fuhua",
          "text": "请。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 297
        }
      ],
      "stageDirections": []
    },
    "H04": {
      "title": "未识别规矩",
      "sourceSceneId": "H04",
      "sourceLine": 299,
      "lines": [
        {
          "id": "H04-01",
          "speaker": "senti",
          "text": "先按普通的来，别磨蹭了。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 301
        }
      ],
      "stageDirections": []
    },
    "I00": {
      "title": "山门",
      "sourceSceneId": "I00",
      "sourceLine": 305,
      "lines": [
        {
          "id": "I00-01",
          "speaker": "senti",
          "text": "看，识境演武！名字是我起的。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 307
        },
        {
          "id": "I00-02",
          "speaker": "fuhua",
          "text": "很合适。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 308
        }
      ],
      "stageDirections": []
    },
    "I01": {
      "title": "面馆",
      "sourceSceneId": "I01",
      "sourceLine": 310,
      "lines": [
        {
          "id": "I01-01",
          "speaker": "senti",
          "text": "两碗云吞面！一碗多加云吞，另一碗——",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 312
        },
        {
          "id": "I01-02",
          "speaker": "fuhua",
          "text": "和你一样就好。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 313
        }
      ],
      "stageDirections": []
    },
    "I01-P": {
      "title": "进攻路线等面闲谈 · 备用",
      "sourceSceneId": "I01-P",
      "sourceLine": 315,
      "lines": [
        {
          "id": "I01-P01",
          "speaker": "senti",
          "text": "你最后那拳，我越想越不服气。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 317
        },
        {
          "id": "I01-P02",
          "speaker": "fuhua",
          "text": "明天再打。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 318
        }
      ],
      "stageDirections": []
    },
    "I01-S": {
      "title": "守势路线等面闲谈 · 备用",
      "sourceSceneId": "I01-S",
      "sourceLine": 320,
      "lines": [
        {
          "id": "I01-S01",
          "speaker": "senti",
          "text": "那个假动作，我可是专门练过的。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 322
        },
        {
          "id": "I01-S02",
          "speaker": "fuhua",
          "text": "练得很好，我险些上当。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 323
        }
      ],
      "stageDirections": []
    },
    "I01-M": {
      "title": "流转路线等面闲谈 · 备用",
      "sourceSceneId": "I01-M",
      "sourceLine": 325,
      "lines": [
        {
          "id": "I01-M01",
          "speaker": "senti",
          "text": "明天我就把那条路封了。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 327
        },
        {
          "id": "I01-M02",
          "speaker": "fuhua",
          "text": "可那是你造的。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 328
        }
      ],
      "stageDirections": []
    },
    "I01-H": {
      "title": "兼修路线等面闲谈 · 备用",
      "sourceSceneId": "I01-H",
      "sourceLine": 330,
      "lines": [
        {
          "id": "I01-H01",
          "speaker": "senti",
          "text": "那两招反过来接，会不会更快？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 332
        },
        {
          "id": "I01-H02",
          "speaker": "fuhua",
          "text": "改天试试。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 333
        }
      ],
      "stageDirections": []
    },
    "I01_CONT": {
      "title": "公共续段 · 备用",
      "sourceSceneId": "I01",
      "sourceLine": 335,
      "lines": [
        {
          "id": "I01-03",
          "speaker": "senti",
          "text": "面来了，先吃！",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 337
        }
      ],
      "stageDirections": []
    },
    "I02": {
      "title": "一碗云吞面",
      "sourceSceneId": "I02",
      "sourceLine": 339,
      "lines": [
        {
          "id": "I02-01",
          "speaker": "fuhua_thought",
          "text": "……立雪。",
          "kind": "thought",
          "displayName": "符华（心想）",
          "sourceLine": 343
        },
        {
          "id": "I02-02",
          "speaker": "senti",
          "text": "……喂，老古董。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 347
        },
        {
          "id": "I02-03",
          "speaker": "fuhua",
          "text": "抱歉，想起以前做云吞面的时候了。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 348
        },
        {
          "id": "I02-04",
          "speaker": "senti",
          "text": "我记得。不过，我可没真吃过。下回做一碗给我尝尝？",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 349
        },
        {
          "id": "I02-05",
          "speaker": "fuhua",
          "text": "好。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 350
        },
        {
          "id": "I02-06",
          "speaker": "senti",
          "text": "说好了啊。先吃，面都快凉了。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 351
        },
        {
          "id": "I02-07",
          "speaker": "fuhua",
          "text": "嗯。",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 352
        }
      ],
      "stageDirections": [
        {
          "beforeLine": 0,
          "text": "短暂闪回：旧日木桌，一碗云吞面。",
          "sourceLine": 341
        },
        {
          "beforeLine": 1,
          "text": "回到现实。桌上的面还冒着热气。",
          "sourceLine": 345
        }
      ]
    },
    "J01": {
      "title": "场边",
      "sourceSceneId": "J01",
      "sourceLine": 356,
      "lines": [
        {
          "id": "J01-01",
          "speaker": "fuhua",
          "text": "打完之后，能带我去看看池子吗？",
          "kind": "dialogue",
          "displayName": "符华",
          "sourceLine": 358
        },
        {
          "id": "J01-02",
          "speaker": "senti",
          "text": "行啊，不过先去吃饭。面馆可不等人。",
          "kind": "dialogue",
          "displayName": "小识",
          "sourceLine": 359
        }
      ],
      "stageDirections": []
    }
  }
}
